---
permalink: /metadata.json
---
[
  {% for item in site.modules %}
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "track": {{ item.track | jsonify }},
    "sequence": {{ item.sequence | jsonify }},
    "abstract": {{ item.abstract | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
